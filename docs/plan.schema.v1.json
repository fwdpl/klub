{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klub.bakutis.pl/schema/plan.v1.json",
  "title": "Plan wyjazdu – klub-plan 1.x",
  "description": "Opis po polsku: docs/plan-format.md. Imiona w „for” i spójność czasów sprawdza dodatkowo import w aplikacji.",
  "type": "object",
  "required": ["format", "version", "revision", "days"],
  "properties": {
    "format": { "const": "klub-plan" },
    "version": { "type": "string", "pattern": "^1\\.\\d+$" },
    "revision": { "type": "integer", "minimum": 1 },
    "trip": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "days": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/day" } }
  },
  "$defs": {
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "timeOrLocal": {
      "type": "string",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2}T)?([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "zone": { "type": "string", "description": "Strefa IANA, np. Atlantic/Reykjavik", "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)+$" },
    "day": {
      "type": "object",
      "required": ["date", "items"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "title": { "type": "string" },
        "base": { "type": "string" },
        "note": { "type": "string" },
        "timezone": { "$ref": "#/$defs/zone" },
        "weather": { "enum": ["beach", "viewpoint", "night-sky"] },
        "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/item" } }
      }
    },
    "item": {
      "type": "object",
      "required": ["time", "title"],
      "properties": {
        "time": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/timeOrLocal" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "type": { "enum": ["activity", "meal", "transport", "flight", "checkin", "meeting", "free"] },
        "for": {
          "oneOf": [
            { "const": "all" },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "important": { "type": "boolean" },
        "fixed": { "type": "boolean" },
        "nearby": { "type": "boolean" },
        "place": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "address": { "type": "string" },
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "route": { "type": "string" },
        "notes": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "rating": { "type": "number", "minimum": 0, "maximum": 5 },
              "address": { "type": "string" }
            }
          }
        },
        "meet": {
          "type": "object",
          "required": ["place"],
          "properties": {
            "place": { "type": "string", "minLength": 1 },
            "time": { "$ref": "#/$defs/timeOrLocal" }
          }
        },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "timezone": { "$ref": "#/$defs/zone" },
        "endTimezone": { "$ref": "#/$defs/zone" }
      }
    }
  }
}
