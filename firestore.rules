rules_version = '2';

// Bezpieczeństwo = te reguły. Każda zmiana modelu danych idzie razem ze zmianą reguł i testów (tests/rules).
// Model: src/model/types.ts, SPEC §3–§4.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- osoba ----------

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isActive() {
      return signedIn() && exists(userPath()) && get(userPath()).data.active == true;
    }

    function isOrganizer() {
      return isActive() && get(userPath()).data.role == 'organizer';
    }

    // ---------- wyjazd ----------

    function memberPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid);
    }

    // status zalogowanej osoby przy wyjeździe albo '' gdy brak wpisu
    function myStatus(tripId) {
      return exists(memberPath(tripId)) ? get(memberPath(tripId)).data.status : '';
    }

    function tripStatus(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data.status;
    }

    // Wyjazd widoczny dla osoby: otwarty/zamknięty dla wszystkich z listy, archiwum tylko dla zatwierdzonych (decyzja B)
    function canSeeTrip(tripId) {
      return isOrganizer()
        || (isActive() && tripStatus(tripId) in ['open', 'closed'])
        || (isActive() && tripStatus(tripId) == 'archived' && myStatus(tripId) == 'approved');
    }

    // WARSTWA 2: zainteresowani + zatwierdzeni
    function canSeeOverview(tripId) {
      return isOrganizer()
        || (canSeeTrip(tripId) && myStatus(tripId) in ['interested', 'approved']);
    }

    // WARSTWA 3: tylko zatwierdzeni
    function canSeeDetails(tripId) {
      return isOrganizer()
        || (canSeeTrip(tripId) && myStatus(tripId) == 'approved');
    }

    // ---------- kolekcje ----------

    // Konta tworzy i zmienia wyłącznie funkcja serwerowa (lista osób organizatora).
    // Użytkownik czyta swój dokument i zmienia tylko tokeny powiadomień oraz preferencje.
    match /users/{uid} {
      allow read: if (isActive() && request.auth.uid == uid) || isOrganizer();
      allow update: if isActive()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens', 'prefs'])
        && request.resource.data.fcmTokens is list
        && request.resource.data.fcmTokens.size() <= 20;
      allow create, delete: if false;
    }

    match /trips/{tripId} {
      // Zapytanie uczestnika musi filtrować po stanie (open/closed) – reguły nie są filtrami
      allow read: if isOrganizer()
        || (isActive() && resource.data.status in ['open', 'closed'])
        || (isActive() && resource.data.status == 'archived' && myStatus(tripId) == 'approved');
      allow create, update: if isOrganizer()
        && request.resource.data.status in ['draft', 'open', 'closed', 'archived']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.timezone is string
        && request.resource.data.timezone.size() > 0
        && request.resource.data.schemaVersion is int;
      allow delete: if isOrganizer();

      // Status osoby przy wyjeździe. Listę widzą zainteresowani i zatwierdzeni (wariant C).
      match /members/{uid} {
        allow read: if isOrganizer()
          || (canSeeTrip(tripId) && (request.auth.uid == uid || myStatus(tripId) in ['interested', 'approved']));

        // „Też tam chcę”: tylko własny wpis, tylko przy otwartym wyjeździe, tylko jako zainteresowany.
        // Po rezygnacji wpis zostaje ze statusem 'withdrawn', więc ponowne zgłoszenie nie jest utworzeniem (decyzja C).
        allow create: if isOrganizer()
          || (isActive()
            && request.auth.uid == uid
            && tripStatus(tripId) == 'open'
            && request.resource.data.keys().hasOnly(['uid', 'displayName', 'status', 'updatedAt'])
            && request.resource.data.uid == uid
            && request.resource.data.status == 'interested'
            && request.resource.data.displayName == get(userPath()).data.displayName
            && request.resource.data.updatedAt == request.time);

        // Wycofanie się: osoba usuwa własny wpis, dopóki nie została zatwierdzona
        allow delete: if isOrganizer()
          || (isActive() && request.auth.uid == uid && resource.data.status == 'interested');

        // Zatwierdzenie i rezygnacja: tylko organizator
        allow update: if isOrganizer()
          && request.resource.data.status in ['interested', 'approved', 'withdrawn']
          && request.resource.data.uid == uid;
      }

      // WARSTWA 2
      match /overview/{docId} {
        allow read: if canSeeOverview(tripId);
        // Karty krajów (overview/countries): lista do 10 krajów; pozostałe dokumenty warstwy 2 bez zmian
        allow write: if isOrganizer()
          && (docId != 'countries'
            || (request.resource.data.keys().hasOnly(['countries', 'updatedAt'])
              && request.resource.data.countries is list
              && request.resource.data.countries.size() <= 10));
      }

      // WARSTWA 3
      match /info/{docId} {
        allow read: if canSeeDetails(tripId);
        allow write: if isOrganizer()
          && request.resource.data.keys().hasOnly(['flights', 'hotels', 'emergencyContacts', 'insurance', 'checklistTemplate', 'planNotes', 'updatedAt'])
          && request.resource.data.flights is list
          && request.resource.data.hotels is list
          && request.resource.data.emergencyContacts is list
          && request.resource.data.checklistTemplate is list;
      }

      // Plan dni: jeden dokument na dzień (id = data); zapisuje organizator (import albo edycja punktu)
      match /days/{date} {
        allow read: if canSeeDetails(tripId);
        allow create, update: if isOrganizer()
          && request.resource.data.keys().hasOnly(['date', 'title', 'note', 'timezone', 'baseLocation', 'weatherDependent', 'weatherPlace', 'items', 'revision', 'updatedAt'])
          && (!('weatherPlace' in request.resource.data) || (request.resource.data.weatherPlace.lat is number && request.resource.data.weatherPlace.lng is number))
          && request.resource.data.date == date
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 100
          && request.resource.data.revision is int;
        allow delete: if isOrganizer();
      }

      // Lista życzeń (v2): miejsca widzą i dodają zatwierdzeni; każdy zmienia tylko swój głos;
      // szczegóły miejsca – ten, kto je dodał, albo organizator
      match /wishes/{wishId} {
        allow read: if canSeeDetails(tripId);
        allow create: if canSeeDetails(tripId)
          && request.resource.data.keys().hasOnly(['name', 'place', 'link', 'preferredTime', 'durationMin', 'fixedTime', 'note', 'addedBy', 'addedByName', 'createdAt', 'votes'])
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
          && request.resource.data.votes is map
          && request.resource.data.votes.keys().hasOnly([request.auth.uid]);
        allow update: if canSeeDetails(tripId)
          && request.resource.data.addedBy == resource.data.addedBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
          && request.resource.data.votes is map
          && (
            // głos: tylko własny wpis w votes
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
              && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid]))
            // szczegóły miejsca: autor albo organizator (bez cudzych głosów)
            || ((resource.data.addedBy == request.auth.uid || isOrganizer())
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'place', 'link', 'preferredTime', 'durationMin', 'fixedTime', 'note'])));
        allow delete: if isOrganizer()
          || (canSeeDetails(tripId) && resource.data.addedBy == request.auth.uid
            && resource.data.votes.keys().hasOnly([request.auth.uid]));
      }

      // Wspólne wydatki (v2): widzą i dodają zatwierdzeni (i organizator); poprawia i usuwa wpisujący albo organizator.
      // Suma udziałów = kwota sprawdza aplikacja (reguły nie sumują map).
      match /expenses/{expenseId} {
        function validExpense(d) {
          return d.keys().hasOnly(['kind', 'title', 'amount', 'currency', 'date', 'category', 'paidBy', 'split', 'shares', 'names', 'note', 'viaPln', 'createdBy', 'createdAt', 'updatedAt'])
            && d.kind in ['expense', 'transfer']
            && d.title is string && d.title.size() > 0 && d.title.size() <= 120
            && d.amount is number && d.amount > 0
            && d.currency is string && d.currency.size() == 3
            && d.date is string && d.date.size() == 10
            && d.paidBy is string
            && d.split in ['equal', 'amounts']
            && d.shares is map && d.shares.size() > 0 && d.shares.size() <= 50
            && d.names is map
            && (!('note' in d) || (d.note is string && d.note.size() <= 500))
            && (!('viaPln' in d) || d.viaPln is bool);
        }
        allow read: if canSeeDetails(tripId);
        allow create: if canSeeDetails(tripId)
          && validExpense(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if canSeeDetails(tripId)
          && (resource.data.createdBy == request.auth.uid || isOrganizer())
          && validExpense(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if canSeeDetails(tripId)
          && (resource.data.createdBy == request.auth.uid || isOrganizer());
      }

      // Wpłaty na wyjazd (v2): dokument na osobę; wpisuje i odhacza tylko organizator, osoba widzi tylko swoje
      match /payments/{uid} {
        allow read: if isOrganizer() || (request.auth.uid == uid && canSeeTrip(tripId));
        allow create, update: if isOrganizer()
          && request.resource.data.keys().hasOnly(['name', 'items', 'updatedAt'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 50;
        allow delete: if isOrganizer();
      }

      // Checklista osobista: właściciel (zatwierdzony) odhacza punkty wspólne (templateDone)
      // i dopisuje własne (items); organizator widzi i zmienia wszystko (decyzja F)
      match /checklists/{uid} {
        allow read: if isOrganizer() || (request.auth.uid == uid && canSeeDetails(tripId));
        allow create, update: if isOrganizer()
          || (request.auth.uid == uid
            && canSeeDetails(tripId)
            && request.resource.data.keys().hasOnly(['items', 'templateDone', 'updatedAt'])
            && request.resource.data.items is list
            && request.resource.data.items.size() <= 200
            && (!('templateDone' in request.resource.data) || request.resource.data.templateDone is map));
        allow delete: if isOrganizer();
      }
    }

    // Własne statusy na wszystkich wyjazdach jednym zapytaniem (collection group).
    // Zapytanie musi filtrować po uid zalogowanej osoby – reguły nie są filtrami.
    match /{path=**}/members/{memberId} {
      allow read: if isActive() && resource.data.uid == request.auth.uid;
    }

    // Kody logowania i licznik prób: tylko funkcje serwerowe (konto serwisowe omija reguły)
    match /loginCodes/{id} {
      allow read, write: if false;
    }

    match /loginAttempts/{id} {
      allow read, write: if false;
    }

    // Wszystko inne zamknięte
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
